{
  "name": "log4abap",
  "private": true,
  "description": "Local checks for the log4abap abapGit repository (not deployed to SAP)",
  "scripts": {
    "lint": "abaplint",
    "unit": "node -e \"require('fs').rmSync('output',{recursive:true,force:true})\" && abap_transpile test/abap_transpile.json && node output/index.mjs",
    "test": "npm run lint && npm run unit"
  },
  "devDependencies": {
    "@abaplint/cli": "2.120.92",
    "@abaplint/database-sqlite": "2.14.12",
    "@abaplint/runtime": "2.14.16",
    "@abaplint/transpiler-cli": "2.14.16"
  }
}
